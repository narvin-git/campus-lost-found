# Copy to server/.env and fill in real values. Never commit .env.

# --- Web server ---
PORT=3000
# 0.0.0.0 = reachable from other devices on the LAN (phone test)
HOST=0.0.0.0

# --- Database: Local (MySQL 8.0) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=lostfound_app
DB_PASSWORD=
DB_NAME=campus_lost_found
DB_SSL=false

# --- Database: Production (TiDB Cloud Serverless), reference only ---
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=<cluster-prefix>.root
# DB_PASSWORD=
# DB_NAME=campus_lost_found
# DB_SSL=true
# Optional CA file. Leave unset on Render (Node already trusts ISRG Root X1).
# Local example: DB_SSL_CA=C:\Users\User\tidb-ca.pem
# DB_SSL_CA=

# --- Rate limiter ---
# Unset or 0 = off. Set e.g. 100 to allow 100 API requests per IP per 15 minutes.
RATE_LIMIT_MAX=0
# Proxy hops in front of Node (1 = Apache locally / Render's proxy). Only used when the limiter is on.
TRUST_PROXY=1

# --- Automatic backup (local only) ---
# true = run mysqldump after every INSERT/UPDATE/DELETE, writing backup.sql in the project root
AUTO_BACKUP=false
# Full path if mysqldump is not on PATH
MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
